+# tsf/thor patch: TSF_KV_VIEWS=N sizes the AR-Diffusion KV ring (default + worst case) for N views instead of all
+# manifest cameras with LiDAR, so Sim-Auto fits next to the resident LLM. 0 = stock behaviour.
+# TSF_KV_LIDAR=1 (only with TSF_KV_VIEWS) sizes it for joint camera+LiDAR requests (adds the LiDAR tokens of every
+# chunk to the frame unit); 0 = RGB-only. Joint requests need 1.
+_TSF_KV_VIEWS = int(os.environ.get("TSF_KV_VIEWS", "0"))
+_TSF_KV_LIDAR = os.environ.get("TSF_KV_LIDAR", "0") not in ("", "0")
+# TSF_LIDAR_CHUNK=N overrides the checkpoint's LiDAR VAE streaming chunk (20 sweeps). The FP32 encoder / decoder run 20 sweeps of
+# 128 x 1808 at once; next to the resident LLM the unified memory has no room for that (a 3-view joint request on thor3 drove
+# MemAvailable from ~30 GB to < 1 GB and the worker was killed). Chunks are causal with ``streaming_context_frames`` (21) of
+# history, so a smaller chunk only gives each sweep more context. 0 = stock behaviour.
+_TSF_LIDAR_CHUNK = int(os.environ.get("TSF_LIDAR_CHUNK", "0"))
+# TSF_KV_RES=720 sizes the KV ring for 720p requests (the checkpoint default is 480: a 720p request overruns a
+# 480p-sized ring). Empty = stock behaviour.
+_TSF_KV_RES = os.environ.get("TSF_KV_RES", "")
+
