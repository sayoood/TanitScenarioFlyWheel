{"id": "uc1_oncoming_late_brake", "parent": "examples/uc1_left_turn_intersection.json", "requests": {"behavior": "the first oncoming car arrives much faster and brakes late, so the ego has to react to it"}, "expect": {"actors_touched": ["oncoming*"]}, "separate": false}
{"id": "uc1_pedestrian_exit", "parent": "examples/uc1_left_turn_intersection.json", "requests": {"behavior": "a pedestrian crosses the road in front of the ego on the arm it turns into"}, "expect": {"new_actors_min": 1, "new_actor_categories": ["pedestrian"]}, "separate": false}
