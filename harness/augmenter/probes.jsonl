{"id": "uc1_night_heavy_rain", "parent": "examples/uc1_left_turn_intersection.json", "requests": {"weather": "night with heavy rain"}, "expect": {"env": {"weather": ["heavy_rain"], "band": "night"}}, "separate": false}
