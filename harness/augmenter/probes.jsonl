{"id": "uc1_road_works", "parent": "examples/uc1_left_turn_intersection.json", "requests": {"environment": "road works: cones close the right lane, a 30 km/h sign and a road-works sign before the junction"}, "expect": {"static_kinds_any": ["cone"], "signs": [{"sign_type": "speed_limit", "sign_value": 30}, {"sign_type": "road_works"}]}, "requires": "static_objects", "separate": false}
